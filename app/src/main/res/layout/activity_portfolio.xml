<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/syntech_background">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:background="@color/syntech_dark">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/syntech_logo"
            android:contentDescription="Syntech Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Syntech Software"
            android:textColor="@color/syntech_white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Portfolio"
                android:textColor="@color/syntech_text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- PROJECT CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@color/syntech_white">

                <ImageView
                    android:id="@+id/portfolioImage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/edm_fabricator"
                    android:scaleType="centerCrop"
                    android:contentDescription="EDM Fabricators project" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="EDM Fabricators"
                    android:textColor="@color/syntech_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This project provides a full technical digital presence for a heavy industrial sector supplier, featuring high-impact architecture and streamlined B2B procurement."
                    android:textColor="@color/syntech_gray"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Developed by Claudio Watson"
                    android:textColor="@color/syntech_gray"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/visitWebsiteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Visit Website"
                    android:textAllCaps="false"
                    android:textColor="@color/syntech_white"
                    android:backgroundTint="@color/syntech_blue" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/navigation_bar" />

</LinearLayout>